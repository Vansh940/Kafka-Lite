<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.vansh.kafkalite</groupId>
  <artifactId>kafka-lite</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>broker-core</module>
    <module>broker-network</module>
    <module>broker-replication</module>
    <module>broker-coordination</module>
    <module>broker-server</module>
    <module>client-producer</module>
    <module>client-consumer</module>
    <module>benchmark</module>
  </modules>

  <!-- Shared version numbers, declared once here, used by every child without repeating <version> -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-framework</artifactId>
        <version>5.6.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-recipes</artifactId>
        <version>5.6.0</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.13</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.5.6</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.10.2</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>1.19.7</version>
        <scope>test</scope>
      </dependency>

      <!-- Internal modules, so children can depend on each other without repeating the version -->
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>broker-core</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>broker-network</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>broker-replication</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>broker-coordination</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>client-producer</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.vansh.kafkalite</groupId>
        <artifactId>client-consumer</artifactId>
        <version>1.0.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module gets these without redeclaring them -->
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>